<?xml version="1.0"?>
<robot name="cestra_diff">

  <!-- Materials -->
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.2 1 1"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>

  <!--
    Coordinate convention:
      +X = forward
      +Y = left
      +Z = up
    base_link is at the wheel axle height. Spawn the model at z=0.05 m
    so the 0.05 m radius wheels initially touch a flat ground plane.
  -->
  <link name="base_link">
    <inertial>
      <!-- Chassis dimensions: 0.30 x 0.30 x 0.15 m; mass = 0.5 kg -->
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0046875" ixy="0" ixz="0"
               iyy="0.0046875" iyz="0" izz="0.0075"/>
    </inertial>

    <visual name="chassis_visual">
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.15"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision name="chassis_collision">
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.15"/>
      </geometry>
    </collision>
  </link>

  <!-- Left drive wheel: center at y=+0.175 m, axle along Y. -->
  <link name="left_wheel">
    <inertial>
      <mass value="0.1"/>
      <!-- Solid cylinder: radius 0.05 m, width 0.02 m; axis along Y. -->
      <inertia ixx="0.0000658333333" ixy="0" ixz="0"
               iyy="0.000125" iyz="0" izz="0.0000658333333"/>
    </inertial>
    <visual name="left_wheel_visual">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision name="left_wheel_collision">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.175 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right drive wheel: center at y=-0.175 m, axle along Y. -->
  <link name="right_wheel">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000658333333" ixy="0" ixz="0"
               iyy="0.000125" iyz="0" izz="0.0000658333333"/>
    </inertial>
    <visual name="right_wheel_visual">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision name="right_wheel_collision">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.175 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Fixed spherical caster at the front (+X). Its friction is reduced
       so it can slide as a simple caster approximation. -->
  <link name="caster_wheel">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0"
               iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <visual name="caster_visual">
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision name="caster_collision">
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!-- Gazebo Sim (Harmonic) differential-drive system. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.35</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- By default this publishes to
         /world/<world_name>/model/<model_name>/joint_state as gz.msgs.Model.
         Bridge that exact topic to sensor_msgs/msg/JointState. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

</robot>