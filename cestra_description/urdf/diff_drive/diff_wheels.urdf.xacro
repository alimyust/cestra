<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="diff_wheel"
               params="prefix parent_link x y z roll pitch yaw">

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent_link}"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} ${z}"
              rpy="${roll} ${pitch} ${yaw}"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}_wheel">

      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${diff_wheel_radius}"
                    length="${diff_wheel_width}"/>
        </geometry>
        <material name="blue"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${diff_wheel_radius}"
                    length="${diff_wheel_width}"/>
        </geometry>
      </collision>

      <xacro:inertial_cylinder
          mass="0.1"
          length="${diff_wheel_width}"
          radius="${diff_wheel_radius}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:inertial_cylinder>

    </link>

  </xacro:macro>

</robot>
